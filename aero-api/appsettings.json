{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=loty.db"
  },
  "Jwt": {
    "Issuer": "LotyApi",
    "Audience": "LotyApiClients",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 7
  },
  "Cors": {
    "Origins": [ "https://loty.example.com" ]
  },
  "RateLimiting": {
    "LoginPermitLimit": 5,
    "LoginWindowMinutes": 1
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "AllowedHosts": "*"
}
