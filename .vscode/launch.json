    "version": "0.2.0",
    "configurations": [
        {
            "name": "C#: LotyApi",
            "type": "dotnet",
            "request": "launch",
            "projectPath": "${workspaceFolder}\\aero-api\\LotyApi.csproj",
            "launchConfigurationId": "TargetFramework=;LotyApi"
        },
        {
            "name": "Frontend: Vite Dev",
            "type": "node",
            "request": "launch",
            "cwd": "${workspaceFolder}/aero-front",
            "runtimeExecutable": "npm",
            "runtimeArgs": ["run", "dev"],
            "console": "integratedTerminal"
        }
    ],
    "compounds": [
        {
            "name": "Full Stack (API + Frontend)",
            "configurations": ["C#: LotyApi", "Frontend: Vite Dev"]
        }
    ]
}